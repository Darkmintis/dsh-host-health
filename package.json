{
  "name": "@darkmintis/dsh-host-health",
  "version": "0.1.0",
  "description": "Host resource, port, and stale dev-process tools for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "AGENTS.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --test-isolation=none \"test/*.test.js\"",
    "build": "node scripts/build-check.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darkmintis/dsh-host-health.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "monitoring",
    "system-monitor",
    "ports",
    "windows"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
